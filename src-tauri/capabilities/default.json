{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "/var/lib/zerotier-one/authtoken.secret" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "/var/lib/zerotier-one/authtoken.secret" }]
    }
  ]
}
