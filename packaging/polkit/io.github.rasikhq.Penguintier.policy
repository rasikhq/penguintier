<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  Polkit actions for "Authorize Penguintier…" (see docs/architecture.md,
  "ZeroTier API token") and "Enable DNS support…" (see "Enable DNS
  support" there).

  The tray runs `pkexec /usr/libexec/penguintier/penguintier-token-helper`.
  pkexec looks for an action whose exec.path annotation matches that exact
  path, and shows this action's message in the password prompt instead of
  the generic "run as the super user" text. The helper prints the token, and
  the tray saves a private copy in ~/.zeroTierOneAuthToken, so this prompt
  appears once, not on every start.

  Defaults:
  - allow_active=auth_admin: a user at the machine must enter an admin
    password every time. No "keep" (auth_admin_keep): the token gives full
    control of ZeroTier, and the prompt is rare anyway.
  - allow_inactive and allow_any=no: never from an inactive session, SSH or
    a background service.

  The second action, enable-dns, runs penguintier-dns-helper the same way:
  it switches the computer's DNS to systemd-resolved after backing up the
  affected files, and undoes the switch by itself if names stop resolving.
  Same defaults: an admin password every time, active sessions only.

  Install for local testing with `make dev-install-helper`.
-->
<policyconfig>
  <vendor>Penguintier</vendor>
  <vendor_url>https://github.com/rasikhq/penguintier</vendor_url>
  <icon_name>io.github.rasikhq.Penguintier</icon_name>

  <action id="io.github.rasikhq.Penguintier.read-token">
    <description>Let Penguintier control ZeroTier</description>
    <message>Penguintier needs to read the ZeroTier service's API token so it can show and change your ZeroTier networks. It keeps a private copy in your home folder, so you are asked only once.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/penguintier/penguintier-token-helper</annotate>
  </action>

  <action id="io.github.rasikhq.Penguintier.enable-dns">
    <description>Switch this computer's DNS to systemd-resolved</description>
    <message>Penguintier needs to install systemd-resolved and switch this computer's DNS to it, so ZeroTier networks can set DNS for their own domains. It backs up the files it changes first and puts them back by itself if names stop resolving.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/penguintier/penguintier-dns-helper</annotate>
  </action>
</policyconfig>
